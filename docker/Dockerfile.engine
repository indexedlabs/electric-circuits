# electric-circuits ENGINE image: the Rust binary that tails Postgres logical replication, maintains
# shapes/subqueries/aggregations, and serves both the control-plane HTTP API and the
# Electric-compatible `GET /v1/shape` endpoint.
#
# Build context is the repo root:
#   docker build -f docker/Dockerfile.engine -t electric-circuits-engine .
#
# The engine supports private HTTP or verified HTTPS with optional mTLS to Durable Streams. PostgreSQL query and
# logical-replication connections use rustls with an explicit CA bundle; no OpenSSL runtime is
# required.

FROM rust:1.96.0-bookworm AS build
RUN apt-get update && apt-get install -y --no-install-recommends cmake pkg-config && rm -rf /var/lib/apt/lists/*
WORKDIR /repo
COPY Cargo.toml Cargo.lock rust-toolchain.toml ./
# `.cargo/config.toml` bakes JEMALLOC_SYS_WITH_MALLOC_CONF into the allocator. jemalloc reads its
# configuration before `main`, and the prefixed `_rjem_` build ignores the runtime `MALLOC_CONF`
# name entirely, so leaving this out ships an image with jemalloc's default (never-returning) decay.
COPY .cargo .cargo
COPY apps/engine apps/engine
RUN cargo build --release --locked -p electric-circuits-engine

FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates && rm -rf /var/lib/apt/lists/*
COPY --from=build /repo/target/release/electric-circuits-engine /usr/local/bin/electric-circuits-engine
COPY docker/aws-rds-us-east-1-bundle.pem /etc/ssl/certs/aws-rds-us-east-1-bundle.pem

# Required:
#   ELECTRIC_CIRCUITS_DS_URL   durable-streams base URL (e.g. http://ds:8791)
#   ELECTRIC_CIRCUITS_PG_URL   Postgres URL (wal_level=logical; the engine creates its slot)
#                              Nonlocal hosts require sslmode=verify-full.
#   ELECTRIC_CIRCUITS_PG_TLS_CA_BUNDLE
#                              Absolute CA bundle path for nonlocal Postgres. This image includes
#                              /etc/ssl/certs/aws-rds-us-east-1-bundle.pem for RDS us-east-1.
# Optional:
#   ELECTRIC_CIRCUITS_PG_TABLES  comma list of `schema.name` / bare `name` (= public.<name>) /
#                           `schema.*`; `*` (the default here) = every `public` table with a PK
#   ELECTRIC_CIRCUITS_PG_SLOT    slot name (default electric_circuits)
#   ELECTRIC_CIRCUITS_BIND       bind address (default here 0.0.0.0:7010)
#   ELECTRIC_CIRCUITS_LOG        tracing filter (default info)
#   ELECTRIC_CIRCUITS_TRACE      0/false/off unregisters the visualizer introspection endpoints
#                           (/trace /graph /state — unauthenticated when on; default on)
ENV ELECTRIC_CIRCUITS_BIND=0.0.0.0:7010 \
    ELECTRIC_CIRCUITS_PG_TABLES=*

EXPOSE 7010
HEALTHCHECK --interval=5s --timeout=3s --retries=12 \
  CMD ["/bin/bash", "-c", "exec 3<>/dev/tcp/127.0.0.1/7010 && printf 'GET /health HTTP/1.0\\r\\n\\r\\n' >&3 && head -1 <&3 | grep -q 200"]
CMD ["electric-circuits-engine"]
